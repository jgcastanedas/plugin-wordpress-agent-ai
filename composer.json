{
    "name": "jgcastanedas/ai-agent-chatbot",
    "description": "AI Agent Chatbot for WordPress with WooCommerce, vector KB, WhatsApp webhooks.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --coverage-text --colors=always"
    },
    "config": {
        "sort-packages": true
    }
}
